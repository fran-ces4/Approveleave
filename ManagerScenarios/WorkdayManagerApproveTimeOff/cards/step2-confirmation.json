{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "✅ Request approved",
      "weight": "Bolder",
      "size": "Medium",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "The time off request has been approved.",
      "wrap": true,
      "spacing": "Small"
    },
    {
      "type": "Table",
      "spacing": "Medium",
      "showGridLines": false,
      "firstRowAsHeader": false,
      "columns": [
        { "width": 1 },
        { "width": 2 }
      ],
      "rows": [
        {
          "type": "TableRow",
          "cells": [
            {
              "type": "TableCell",
              "items": [{ "type": "TextBlock", "text": "Employee", "weight": "Bolder" }]
            },
            {
              "type": "TableCell",
              "items": [{ "type": "TextBlock", "text": "Jane Smith", "wrap": true }]
            }
          ]
        },
        {
          "type": "TableRow",
          "cells": [
            {
              "type": "TableCell",
              "items": [{ "type": "TextBlock", "text": "Decision", "weight": "Bolder" }]
            },
            {
              "type": "TableCell",
              "items": [{ "type": "TextBlock", "text": "Approve", "wrap": true }]
            }
          ]
        },
        {
          "type": "TableRow",
          "cells": [
            {
              "type": "TableCell",
              "items": [{ "type": "TextBlock", "text": "Status", "weight": "Bolder" }]
            },
            {
              "type": "TableCell",
              "items": [{ "type": "TextBlock", "text": "Approved", "wrap": true }]
            }
          ]
        },
        {
          "type": "TableRow",
          "cells": [
            {
              "type": "TableCell",
              "items": [{ "type": "TextBlock", "text": "Event ID", "weight": "Bolder" }]
            },
            {
              "type": "TableCell",
              "items": [{ "type": "TextBlock", "text": "BP-001234", "wrap": true }]
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "horizontalAlignment": "Right",
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "Image",
                  "url": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=",
                  "style": "RoundedCorners",
                  "size": "Small",
                  "height": "20px",
                  "width": "20px"
                }
              ],
              "verticalContentAlignment": "Center"
            },
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "Workday",
                  "size": "Small",
                  "color": "#242424",
                  "weight": "Bolder"
                }
              ],
              "verticalContentAlignment": "Center",
              "spacing": "Small"
            }
          ]
        }
      ]
    }
  ],
  "actions": []
}
