{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "Act on inbox task",
      "weight": "Bolder",
      "size": "Medium",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "Fields marked with * are required.",
      "wrap": true,
      "spacing": "Medium",
      "size": "Small"
    },
    {
      "type": "Input.ChoiceSet",
      "id": "selectedTask",
      "label": "Select a task",
      "style": "compact",
      "isRequired": true,
      "errorMessage": "Please select a task.",
      "choices": [
        {
          "title": "Absence Request (Absence Request)",
          "value": "BP-001234"
        },
        {
          "title": "Benefits Change — Medical (Benefits Change)",
          "value": "BP-005678"
        },
        {
          "title": "Org Assignment — Finance Dept (Organization Assignment)",
          "value": "BP-009012"
        }
      ]
    },
    {
      "type": "Input.ChoiceSet",
      "id": "taskAction",
      "label": "Your decision",
      "style": "expanded",
      "isRequired": true,
      "errorMessage": "Please select an action.",
      "choices": [
        { "title": "Approve", "value": "Approve" },
        { "title": "Deny", "value": "Deny" },
        { "title": "Send back", "value": "Send Back" }
      ]
    },
    {
      "type": "Input.Text",
      "id": "taskComment",
      "label": "Comment (optional)",
      "placeholder": "Add a note...",
      "isMultiline": true
    },
    {
      "type": "ColumnSet",
      "spacing": "Medium",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "ActionSet",
              "actions": [
                { "type": "Action.Submit", "title": "Submit", "id": "Submit" },
                { "type": "Action.Submit", "title": "Cancel", "id": "Cancel" }
              ]
            }
          ],
          "verticalContentAlignment": "Center"
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [],
          "verticalContentAlignment": "Center"
        },
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "ColumnSet",
              "spacing": "None",
              "columns": [
                {
                  "type": "Column",
                  "width": "auto",
                  "items": [
                    {
                      "type": "Image",
                      "url": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=",
                      "style": "RoundedCorners",
                      "size": "Small",
                      "height": "20px",
                      "width": "20px"
                    }
                  ],
                  "verticalContentAlignment": "Center"
                },
                {
                  "type": "Column",
                  "width": "auto",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "Workday",
                      "size": "Small",
                      "color": "#242424",
                      "weight": "Bolder"
                    }
                  ],
                  "verticalContentAlignment": "Center",
                  "spacing": "Small"
                }
              ]
            }
          ],
          "verticalContentAlignment": "Center"
        }
      ]
    }
  ],
  "actions": []
}
